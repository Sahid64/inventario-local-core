{
  "name": "@inventario-local/desktop",
  "version": "1.0.0",
  "private": true,
  "author": "Inventario Local",
  "description": "Aplicación de escritorio 100% offline (Electron) para Sistema de Inventario Local White-Label",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "prepare:bundle": "node scripts/prepare-bundle.mjs",
    "build": "node scripts/prepare-bundle.mjs && electron-builder",
    "build:dir": "node scripts/prepare-bundle.mjs && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.inventariolocal.core",
    "productName": "Inventario Local",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "resources-bundle/backend/node_modules/.prisma/client/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "resources-bundle/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
